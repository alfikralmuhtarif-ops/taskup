# Copy to .env ON THE SERVER and fill in. .env is gitignored — never commit it.
#
# Generate each secret with:  openssl rand -base64 32

POSTGRES_DB=taskup
POSTGRES_USER=taskup
POSTGRES_PASSWORD=

# Minimum 32 bytes. Rotating it invalidates every issued access token.
JWT_SIGNING_KEY=

# Base64 AES-256 key for field-level encryption of phone numbers, message text and
# note bodies. THERE IS NO RECOVERY PATH: lose this and that data is gone for good.
# Back it up somewhere other than this server, before the first user registers.
ENCRYPTION_KEY_V1=

# One-time secret for POST /admin/bootstrap, used to promote the first admin.
ADMIN_BOOTSTRAP_SECRET=

# Baked into the frontend bundles at image build time.
VITE_API_URL=https://api.taskupapp.net

# TEMPORARY AUTH BYPASS — leave empty unless you know exactly why you are setting it.
# While set, the numbers in OTP_FIXED_CODE_PHONES below sign in with this exact code.
# Every other number still gets a real random code, so an account you did not list
# is never reachable this way. Clear both once SMS delivery works.
OTP_FIXED_CODE=

# Required whenever OTP_FIXED_CODE is set: the E.164 numbers the fixed code applies
# to, comma-separated. The API refuses to start with a fixed code and no list, because
# an unscoped one would let anyone sign in as any user.
#   OTP_FIXED_CODE_PHONES=+966500000000,+966555555555
OTP_FIXED_CODE_PHONES=
