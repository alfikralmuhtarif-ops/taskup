# ── Dependencies / build output ───────────────────────────────────────────────
node_modules/
dist/
build/
bin/
obj/

# ── Secrets ───────────────────────────────────────────────────────────────────
# appsettings.Development.json holds the real AES-256 field-encryption key used by
# the local dev database (Encryption:Keys). Losing or leaking it is not recoverable
# — every encrypted User.Phone / Message.Text / note body is tied to it. Keep a copy
# somewhere safe outside the repo; a fresh clone must supply its own key and will
# not be able to read an existing dev database without the original.
appsettings.Development.json
appsettings.*.Local.json
.env
.env.*
!.env.example

# ── User-uploaded content (LocalFileStorage dev stub) ─────────────────────────
backend/src/TaskUp.Api/uploads/

# ── Editor / OS ───────────────────────────────────────────────────────────────
.DS_Store
.vs/
.vscode/
.idea/
*.user
*.swp

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── Server-side deployment state (created on the VPS, never committed) ────────
deploy/letsencrypt/
deploy/certbot-webroot/
deploy/nginx/active/
# Built bundles the proxy bind-mounts: the landing page from landing/, the admin
# panel from admin-panel/. Populated on the server at deploy time, so ignoring them
# keeps a local build from being committed as if it were source.
deploy/panel/
deploy/site/

# Android release signing — never commit these.
android/taskup-release.jks
android/keystore.properties
*.jks
keystore.properties

# Python bytecode
__pycache__/
*.pyc
