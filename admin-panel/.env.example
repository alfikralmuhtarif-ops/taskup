# Base URL of the TaskUp API. Vite inlines this at BUILD time — rebuild to change it.
# Local development: http://localhost:5311
# Production build:  https://api.taskupapp.net
#
# Must be absolute. A relative value like "/api" resolves against whatever origin
# serves the panel, which in production is the static site itself — every call
# then 404s against index.html, and the built bundle contains no hostname at all,
# so nothing reveals the mistake until the panel is live.
VITE_API_URL=http://localhost:5311
