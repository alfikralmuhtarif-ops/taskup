{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5436;Database=taskup;Username=taskup;Password=taskup"
  },
  "Jwt": {
    "Issuer": "TaskUp",
    "Audience": "TaskUp.Client",
    "SigningKey": "dev-only-signing-key-replace-in-production-minimum-32-bytes",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "FileStorage": {
    "RootPath": "uploads",
    "PublicPathPrefix": "/uploads"
  },
  "AdminBootstrap": {
    "Secret": "dev-only-bootstrap-secret-change-me"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5180", "http://localhost:8443" ]
  },
  "Otp": {
    "FixedCode": "111111"
  },
  "Encryption": {
    "CurrentKeyVersion": 1,
    "Keys": {
      "1": ""
    }
  }
}
