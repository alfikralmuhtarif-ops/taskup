# syntax=docker/dockerfile:1
# One nginx image serving both SPAs and reverse-proxying the API. Build context is the
# repository root, because it needs both frontend directories.

# ── User app ──────────────────────────────────────────────────────────────────
FROM node:24-alpine AS app-build
RUN corepack enable
WORKDIR /src
COPY ["Front-end design for TaskUp/package.json", "Front-end design for TaskUp/pnpm-lock.yaml", "./"]
RUN pnpm install --frozen-lockfile
COPY ["Front-end design for TaskUp/", "./"]
# Baked in at build time, not read at runtime — Vite inlines import.meta.env.
ARG VITE_API_URL=https://api.taskupapp.net
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm exec vite build

# ── Admin panel ───────────────────────────────────────────────────────────────
FROM node:24-alpine AS admin-build
RUN corepack enable
WORKDIR /src
COPY admin-panel/package.json admin-panel/*.lock admin-panel/*lock.yaml ./
RUN (pnpm install --frozen-lockfile || npm install)
COPY admin-panel/ ./
ARG VITE_API_URL=https://api.taskupapp.net
ENV VITE_API_URL=$VITE_API_URL
RUN (pnpm exec vite build || npx vite build)

# ── Serve ─────────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime
COPY --from=app-build   /src/dist /usr/share/nginx/html/app
COPY --from=admin-build /src/dist /usr/share/nginx/html/admin
COPY deploy/nginx/taskup.conf /etc/nginx/conf.d/default.conf
